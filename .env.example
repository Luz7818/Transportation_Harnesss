# 复制为 .env 并按需修改;所有变量均为可选,不设置即使用安全默认值

# ===== 服务 =====
# HOST=0.0.0.0              # 默认 127.0.0.1;公网部署改 0.0.0.0
# PORT=8765
# AUTH_MODE=login           # login(默认,浏览器需登录)| open(内网演示免登录)
# AUTH_TOKEN=change-me-to-a-long-random-string   # 机器客户端(小程序/脚本)令牌,公网必设
# CORS_ORIGINS=https://your-frontend.example.com # 默认 *;配置具体来源才启用跨域凭证

# ===== 初始管理员(仅首次启动生效,之后请在界面修改) =====
# ADMIN_USER=admin
# ADMIN_PASSWORD=harness123

# ===== LLM 智能层(三枚全部设置才启用真实模型;否则自动离线 Mock) =====
# LLM_BASE_URL=https://api.deepseek.com/v1   # 任意 OpenAI 兼容端点(OpenAI/vLLM/Ollama 等)
# LLM_API_KEY=sk-xxxx
# LLM_MODEL=deepseek-chat
