# 复制为 .env 并按需修改;所有变量均为可选,不设置即使用安全默认值。
# 注意:.env 已在 .gitignore 里,里面的真实值永远不会(也不该)进仓库。
# 每一项都能通过 Web 看板的「系统设置」(/api/settings)在线查看与修改,
# 密钥类只回掩码;标了「重启生效」的键改完必须重启服务进程。

# ===== 服务 =====
# HOST=0.0.0.0              # 默认 127.0.0.1;公网部署改 0.0.0.0(重启生效)
# PORT=8765                 # 默认 8765(重启生效)
# AUTH_MODE=login           # login(默认,浏览器需登录)| open(内网演示免登录)(重启生效)
# AUTH_TOKEN=<长随机串>      # 机器客户端(小程序/脚本)令牌,公网必设(重启生效);
#                           # 短于 16 字符服务会拒绝启动
#                           # 生成一条:python -c "import secrets;print(secrets.token_urlsafe(32))"
# CORS_ORIGINS=https://your-frontend.example.com  # 默认 *;配置具体来源才启用跨域凭证(重启生效)
# COOKIE_SECURE=1           # HTTPS 部署时设 1,会话 Cookie 只经加密通道回传(重启生效)

# ===== 管理员账密(部署者自备;凭据语义的完整说明见 DEPLOY.md) =====
# ADMIN_USER=admin
# ADMIN_PASSWORD=<你自己的强口令>
#   提供即视为已设置(default_credentials=false),业务接口立即可用;
#   auth.json 已存在且默认口令未改时,重启提供它 = 就地轮换并解除 403 门禁;
#   已在界面改过口令的部署不受该变量影响(不会被覆盖);
#   留空也会启动:随机生成一枚强口令只打印一次,但改掉口令前业务接口一律 403;
#   忘记口令:停止服务 → 删除 webapp/auth.json → 重启。

# ===== 运行时配置界面 /api/settings(默认关闭) =====
# SETTINGS_ENABLED=1        # 显式开启才可用;开启后非本机访问仍必须携带已登录会话(重启生效)

# ===== LLM 智能层(base_url + api_key 两枚设置即启用真实模型;否则自动离线 Mock) =====
# LLM_BASE_URL=https://api.example.com/v1   # 任意 OpenAI 兼容端点(OpenAI/vLLM/Ollama 等)
# LLM_API_KEY=<你的模型密钥>                 # 无鉴权端点可填 EMPTY;留空即离线 Mock
# LLM_MODEL=gpt-4o-mini                      # 默认 gpt-4o-mini
# LLM_EXTRA_BODY={"enable_thinking": false}  # 可选:JSON 对象,原样并入请求体(如关闭 Qwen3 思考模式)
