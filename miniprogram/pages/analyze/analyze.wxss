.picker { background: #fff; border: 1rpx solid #e7ebf3; border-radius: 14rpx; padding: 16rpx 20rpx; margin-top: 8rpx; }
.hint { background: #eef1ff; border: 1rpx solid #dfe4ff; color: #4338ca; border-radius: 14rpx;
        padding: 14rpx 20rpx; margin-top: 14rpx; font-size: 24rpx; line-height: 1.6; }
.seg { padding: 12rpx 0; border-bottom: 1rpx solid #f0f3f9; font-size: 26rpx; }
.seg:last-child { border-bottom: 0; }
